# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Indonesian Regional Administrative & Postal Code Service (be_region_indonesia)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=be_region_indonesia
APP_ENV=development                # options: development, staging, production
APP_PORT=8080
APP_TIMEOUT_SECONDS=30
APP_DEBUG=true                      # set to false in production
LOG_LEVEL=debug                     # options: debug, info, warn, error

# ------------------------------------------------------------------------------
# 2. DATABASE SETTINGS (POSTGRESQL)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sample_db
DB_SSLMODE=disable                  # options: disable, require, verify-ca, verify-full
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=60
DB_CONN_MAX_IDLE_TIME_MINUTES=15

# ------------------------------------------------------------------------------
# 3. CACHE SETTINGS (REDIS)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_POOL_SIZE=100
REDIS_DEFAULT_TTL_HOURS=168         # 7 days (7 * 24 = 168 hours)

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# In production, use high-entropy 256-bit+ secret key or path to private key
JWT_SECRET=super-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRATION_MINUTES=15
JWT_ISSUER=be-region-auth-service
JWT_AUDIENCE=be-region-api
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=AdminRegional2026!

# ------------------------------------------------------------------------------
# 5. RATE LIMITING (REDIS SLIDING WINDOW)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_RPM=120           # 120 requests per minute for public read
RATE_LIMIT_SEARCH_RPM=60            # 60 requests per minute for fuzzy search
RATE_LIMIT_ADMIN_RPM=30             # 30 requests per minute for CRUD writes
RATE_LIMIT_AUTH_RPM=10              # 10 requests per minute for login attempts

# ------------------------------------------------------------------------------
# 6. CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# Comma-separated allowed origins (do not use '*' in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://admin.wilayah.go.id
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=86400          # 24 hours preflight cache

# ------------------------------------------------------------------------------
# 7. SWAGGER / OPENAPI DOCUMENTATION
# ------------------------------------------------------------------------------
SWAGGER_ENABLED=true
